# Gitignore settings for ESPHome
# This is an example and may include too much for your use-case.
# You can modify this file to suit your needs.
/.esphome/
/secrets.yaml

# Private working files (photos, videos, original CAD/CAM exports) – never commit
/local/

# Render pipeline output and Python venv (tools/render)
/build/
/.venv/
__pycache__/

# macOS Finder files
.DS_Store
